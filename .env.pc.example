# Copy to ignored .local/pc.env; keep root .env/Supabase configuration separate.
APP_ENV=local
HOST=127.0.0.1
PORT=4001
DATABASE_URL=postgresql://suraksha:REPLACE_WITH_EXISTING_LOCAL_PASSWORD@127.0.0.1:54329/suraksha
