# Hosted controlled pilot only. Store real values in the host's secret manager.
# Do not copy the local .env: it enables the Auth emulator.
APP_ENV=pilot
CONTROLLED_DEMO=true
HOST=0.0.0.0
PORT=4001
DATABASE_URL=REPLACE_WITH_PRIVATE_POSTGRESQL_POSTGIS_URL
FIREBASE_PROJECT_ID=aegis-8972f
# Prefer workload identity/ADC on Google Cloud. On other hosts inject this JSON
# as a secret environment variable; NEVER put it in an APK or Docker build arg.
# FIREBASE_ADMIN_CREDENTIALS_JSON=REPLACE_IN_SECRET_MANAGER_ONLY
SMS_PROVIDER=fake
PUSH_PROVIDER=fake
MAPS_PROVIDER=synthetic
WEB_ORIGIN=https://REPLACE_WITH_WEB_HOST
PUBLIC_TRACKING_BASE_URL=https://REPLACE_WITH_WEB_HOST
DATA_KEY_HEX=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
RECEIPT_SECRET=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ERASURE_LEDGER_PATH=/var/data/erasure-ledger.enc
# FIREBASE_AUTH_EMULATOR_HOST must be absent.
