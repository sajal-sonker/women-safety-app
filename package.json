{
  "name": "surakshaai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "concurrently -k -n api,worker,web \"npm run dev -w @surakshaai/api\" \"npm run dev -w @surakshaai/worker\" \"npm run dev -w @surakshaai/web\"",
    "build": "npm run typecheck && npm run build -w @surakshaai/web",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck -w @surakshaai/web && npm run typecheck -w @surakshaai/mobile",
    "lint": "eslint services packages apps/responder-web apps/mobile/src apps/mobile/specs scripts tests",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "db:migrate": "tsx services/api/src/platform/db/migrate.ts",
    "seed:demo": "tsx services/api/src/seed.ts",
    "test": "node scripts/test-db.mjs tests/api.test.ts tests/contracts.test.ts tests/scoring.test.ts tests/monitoring.test.ts tests/media.test.ts tests/ml-workflow.test.ts tests/hosted-config.test.ts tests/pc-demo-config.test.mjs tests/pc-apk-download.test.mjs tests/private-vpn-artifact.test.mjs",
    "test:unit": "tsx --test tests/scoring.test.ts tests/contracts.test.ts",
    "test:contract": "tsx --test tests/contracts.test.ts",
    "test:integration": "node scripts/test-db.mjs tests/api.test.ts",
    "test:routing": "tsx --test tests/scoring.test.ts",
    "test:journeys": "node scripts/test-db.mjs tests/api.test.ts",
    "test:web": "playwright test",
    "test:mobile": "npm run test -w @surakshaai/mobile -- --runInBand",
    "test:e2e": "playwright test",
    "verify:docs": "node scripts/verify-docs.mjs",
    "auth:emulator": "firebase emulators:start --only auth --project demo-surakshaai --config firebase.json",
    "mobile:metro": "npm run start -w @surakshaai/mobile",
    "test:monitoring": "tsx --test tests/monitoring.test.ts tests/ml-workflow.test.ts",
    "ml:evaluate": "tsx ml/evaluation/evaluate.ts",
    "test:security": "node scripts/test-db.mjs tests/api.test.ts tests/contracts.test.ts tests/media.test.ts",
    "backup:create": "tsx scripts/backup.ts create",
    "restore:verify": "tsx scripts/backup.ts verify",
    "test:load": "tsx scripts/test-load.ts",
    "sbom": "npm sbom --sbom-format cyclonedx",
    "ml:verify": "node scripts/verify-model.mjs",
    "ml:smoke": "node scripts/ml-python.mjs ml/runtime/smoke.py",
    "ml:train": "node scripts/ml-python.mjs ml/training/train.py",
    "ml:training-smoke": "node scripts/ml-python.mjs ml/training/smoke.py",
    "ml:prepare": "node scripts/ml-python.mjs ml/runtime/prepare.py",
    "ml:predict": "node scripts/ml-python.mjs ml/runtime/predict.py",
    "ml:calibrate": "tsx ml/evaluation/calibrate.ts",
    "ml:workflow-smoke": "node scripts/ml-workflow-smoke.mjs",
    "doctor": "node scripts/doctor.mjs",
    "ml:phrases-smoke": "node scripts/ml-python.mjs ml/runtime/phrases_smoke.py",
    "start:hosted": "node scripts/start-hosted.mjs",
    "dev:pc": "node scripts/pc-demo.mjs",
    "auth:pc": "node scripts/pc-demo.mjs auth",
    "doctor:pc": "node scripts/pc-demo.mjs check",
    "test:pc": "node scripts/pc-demo.mjs test",
    "auth:snapshot:pc": "node scripts/pc-demo.mjs snapshot-auth",
    "db:migrate:pc": "node scripts/pc-demo.mjs migrate",
    "verify:pc": "node scripts/verify-pc-demo.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "firebase": "13.2.0",
    "firebase-admin": "14.5.0",
    "helmet": "8.3.0",
    "next": "16.4.6",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.5",
    "suncalc": "2.1.3",
    "yaml": "2.9.1",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.0",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/suncalc": "1.9.2",
    "concurrently": "10.0.7",
    "eslint": "9.39.5",
    "firebase-tools": "15.35.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.7"
  }
}
